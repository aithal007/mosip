{
  "credentialConfigKeyId": "InjiConformanceSdJwt",
  "credentialFormat": "dc+sd-jwt",
  "sdJwtVct": "urn:inji:conformance:person:1",
  "scope": "inji_conformance_sd_jwt",
  "didUrl": "did:web:certify.inji.test:v1:certify",
  "keyManagerAppId": "CERTIFY_VC_SIGN_EC_R1",
  "keyManagerRefId": "EC_SECP256R1_SIGN",
  "signatureAlgo": "ES256",
  "sdClaim": "$.credentialSubject.given_name,$.credentialSubject.family_name,$.credentialSubject.birthdate",
  "displayOrder": ["given_name", "family_name", "birthdate", "nationality", "registration_id"],
  "vcTemplate": {
    "issuer": "${_issuer}",
    "validFrom": "${validFrom}",
    "validUntil": "${validUntil}",
    "credentialSubject": {
      "id": "${_holderId}",
      "given_name": "${given_name}",
      "family_name": "${family_name}",
      "birthdate": "${birthdate}",
      "nationality": "${nationality}",
      "registration_id": "${registration_id}"
    }
  },
  "metaDataDisplay": [
    {
      "name": "Inji Conformance Test Credential",
      "locale": "en",
      "logo": { "uri": "https://mosip.github.io/inji-config/logos/mosipid-logo.png", "alt_text": "MOSIP" },
      "background_image": { "uri": "https://mosip.github.io/inji-config/logos/mosipid-logo.png" },
      "background_color": "#ffffff",
      "text_color": "#1c1f24"
    }
  ],
  "sdJwtClaims": {
    "given_name": { "display": [{ "name": "Given name", "locale": "en" }] },
    "family_name": { "display": [{ "name": "Family name", "locale": "en" }] },
    "birthdate": { "display": [{ "name": "Date of birth", "locale": "en" }] },
    "nationality": { "display": [{ "name": "Nationality", "locale": "en" }] },
    "registration_id": { "display": [{ "name": "Registration ID", "locale": "en" }] }
  }
}
