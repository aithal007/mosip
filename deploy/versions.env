# Pinned versions for reproducible conformance runs. Bump deliberately and commit the
# resulting benchmark changes in the same pull request.

# OpenID Foundation conformance suite (images and scripts/ at this tag)
CONFORMANCE_SUITE_VERSION=release-v5.2.4

# Inji components under test.
# INJI_*_REF pin an exact commit on release-1.0.x, not the branch name: that branch moves,
# and a CI run that fetches a newer commit than was last tested locally can pick up an
# upstream compose-asset change (e.g. a renamed/removed DDL file) with no warning. Bump
# these deliberately, re-validate a full run, and update deploy/verify/initdb accordingly.
INJI_CERTIFY_IMAGE=injistack/inji-certify-with-plugins:1.0.0-alpha.1
INJI_VERIFY_IMAGE=injistack/inji-verify-service:1.0.0-alpha.1
INJI_CERTIFY_REF=f9eb90e21071f779dc0ffdd0836fa45409352d46
INJI_VERIFY_REF=fd081dd4a2fea40c1b3f0e042f7dba0215ac070d

# Upstream compose assets (paths relative to deploy/)
INJI_CERTIFY_COMPOSE_DIR=../upstream/inji-certify/docker-compose/docker-compose-injistack
INJI_VERIFY_DB_SCRIPTS_DIR=../upstream/inji-verify/db_scripts/inji_verify
